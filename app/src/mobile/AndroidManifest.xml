<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Android Auto: declares this app as a media app.
            The Android Auto host reads this to show the app in the
            car's media launcher and route playback controls to RadioPlaybackService.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!--
            Notification small icon used in the Android Auto notification panel,
            lock screen controls, and car media notification bar.
            Must be a single-color (monochrome) vector drawable.
        -->
        <meta-data
            android:name="com.google.android.gms.car.notification.SmallIcon"
            android:resource="@drawable/ic_notification" />

        <activity
            android:name=".MainActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:theme="@style/Theme.EaseAudio.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Theme Launcher Icon Aliases -->
        <activity-alias
            android:name=".MainActivityAliasJazz"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher_jazz"
            android:roundIcon="@mipmap/ic_launcher_jazz"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasRock"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher_rock"
            android:roundIcon="@mipmap/ic_launcher_rock"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAliasCyberpunk"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/tv_banner"
            android:icon="@mipmap/ic_launcher_cyberpunk"
            android:roundIcon="@mipmap/ic_launcher_cyberpunk"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
