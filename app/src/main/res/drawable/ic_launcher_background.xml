<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Cosmic Radial Dark Gradient Canvas -->
    <path android:pathData="M 0,0 h 512 v 512 h -512 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="256"
                android:centerY="102.4"
                android:gradientRadius="409.6"
                android:type="radial">
                <item android:offset="0.0" android:color="#FF280F4A" />
                <item android:offset="0.55" android:color="#FF120524" />
                <item android:offset="1.0" android:color="#FF06020D" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Concentric Ambient Audio Waves -->
    <path
        android:strokeColor="#1500F0FF"
        android:strokeWidth="1.5"
        android:pathData="M 256,256 m -140,0 a 140,140 0 1,0 280,0 a 140,140 0 1,0 -280,0" />
    <path
        android:strokeColor="#10A855F7"
        android:strokeWidth="1.5"
        android:pathData="M 256,256 m -190,0 a 190,190 0 1,0 380,0 a 190,190 0 1,0 -380,0" />
    <path
        android:strokeColor="#0DEC4899"
        android:strokeWidth="1.5"
        android:pathData="M 256,256 m -230,0 a 230,230 0 1,0 460,0 a 230,230 0 1,0 -460,0" />

    <!-- Ambient Cyan Glow (Centered behind transmitter and equalizer) -->
    <path android:pathData="M 256,256 m -180,0 a 180,180 0 1,0 360,0 a 180,180 0 1,0 -360,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="256"
                android:centerY="240"
                android:gradientRadius="180"
                android:type="radial">
                <item android:offset="0.0" android:color="#3000F0FF" />
                <item android:offset="0.5" android:color="#14A855F7" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
