<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base Modern Gradient Background -->
    <path android:pathData="M 0,0 h 108 v 108 h -108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#1A1435" />
                <item android:offset="0.5" android:color="#0F1424" />
                <item android:offset="1.0" android:color="#080B14" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Subtle Cyan Ambient Radial Glow Centered behind Icon -->
    <path android:pathData="M 54,54 m -42,0 a 42,42 0 1,0 84,0 a 42,42 0 1,0 -84,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="42"
                android:type="radial">
                <item android:offset="0.0" android:color="#2E00E5FF" />
                <item android:offset="1.0" android:color="#0000E5FF" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
