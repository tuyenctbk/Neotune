    <!-- Deep Midnight Gradient Background -->
    <path android:pathData="M0,0h320v180h-320z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="320"
                android:endY="180"
                android:type="linear">
                <item android:color="#FF0D1322" android:offset="0.0" />
                <item android:color="#FF1A233A" android:offset="0.5" />
                <item android:color="#FF080C16" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

