    <path android:pathData="M80,90m-110,0a110,110 0 1,0 220,0a110,110 0 1,0 -220,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="80"
                android:centerY="90"
                android:gradientRadius="110"
                android:type="radial">
                <item android:color="#2000F2FE" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <path android:pathData="M260,90m-100,0a100,100 0 1,0 200,0a100,100 0 1,0 -200,0">
