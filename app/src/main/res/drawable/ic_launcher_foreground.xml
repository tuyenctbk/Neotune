<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft Drop Shadow behind 'N' Emblem -->
    <path
        android:fillColor="#50000000"
        android:pathData="M 33,35 L 43,35 L 75,77 L 65,77 Z" />
    <path
        android:fillColor="#40000000"
        android:pathData="M 37,35 L 39,35 A 4.5,4.5 0 0 1 43.5,39.5 L 43.5,72.5 A 4.5,4.5 0 0 1 39,77 L 37,77 A 4.5,4.5 0 0 1 32.5,72.5 L 32.5,39.5 A 4.5,4.5 0 0 1 37,35 Z" />
    <path
        android:fillColor="#40000000"
        android:pathData="M 69,35 L 71,35 A 4.5,4.5 0 0 1 75.5,39.5 L 75.5,72.5 A 4.5,4.5 0 0 1 71,77 L 69,77 A 4.5,4.5 0 0 1 64.5,72.5 L 64.5,39.5 A 4.5,4.5 0 0 1 69,35 Z" />

    <!-- Radio Wave Arcs (Emitting from top right) -->
    <path
        android:strokeColor="#7000E5FF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:pathData="M 76,26 A 9,9 0 0 1 82.5,33" />
    <path
        android:strokeColor="#B000F5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="M 79,20 A 16,16 0 0 1 90,34" />
    <path
        android:strokeColor="#5000F5FF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:pathData="M 83,14 A 23,23 0 0 1 97,35" />

    <!-- Pink/Magenta to Violet Diagonal Bar of 'N' -->
    <path android:pathData="M 32.5,32 L 43.5,32 L 75.5,76 L 64.5,76 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32.5"
                android:startY="32"
                android:endX="75.5"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF2A85" />
                <item android:offset="0.55" android:color="#FFE02096" />
                <item android:offset="1.0" android:color="#FF7928CA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Cyan Pillar of 'N' with Smooth Rounded Caps -->
    <path android:pathData="M 37,32 L 39,32 A 4.5,4.5 0 0 1 43.5,36.5 L 43.5,71.5 A 4.5,4.5 0 0 1 39,76 L 37,76 A 4.5,4.5 0 0 1 32.5,71.5 L 32.5,36.5 A 4.5,4.5 0 0 1 37,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38"
                android:startY="32"
                android:endX="38"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00F5FF" />
                <item android:offset="1.0" android:color="#FF0088FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Amber/Orange Pillar of 'N' with Smooth Rounded Caps -->
    <path android:pathData="M 69,32 L 71,32 A 4.5,4.5 0 0 1 75.5,36.5 L 75.5,71.5 A 4.5,4.5 0 0 1 71,76 L 69,76 A 4.5,4.5 0 0 1 64.5,71.5 L 64.5,36.5 A 4.5,4.5 0 0 1 69,32 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="70"
                android:startY="32"
                android:endX="70"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFB300" />
                <item android:offset="1.0" android:color="#FFFF5500" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
