<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.EaseAudio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Starting Theme for AndroidX Splash Screen -->
    <style name="Theme.EaseAudio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F1424</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.EaseAudio</item>
    </style>
</resources>
